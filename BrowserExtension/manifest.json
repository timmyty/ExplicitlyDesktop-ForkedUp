{
  "manifest_version": 3,
  "name": "Explicitly Video Sync",
  "version": "1.3.0",
  "description": "Keeps YouTube and Steam store video in step with Explicitly Desktop: mutes captioned YouTube videos with no delay, otherwise delays the picture to match the filtered audio. Also streams a YouTube video with the filtered audio to a paired phone.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8766/*",
    "*://*.youtube.com/*",
    "*://store.steampowered.com/*",
    "*://steamcommunity.com/*",
    "*://*.steamstatic.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "remote-core.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "yt_main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://store.steampowered.com/*",
        "*://steamcommunity.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": [
        "remote-core.js",
        "pcm-worklet.js",
        "remote.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pcm-worklet.js"
      ],
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Explicitly: Filter Explicit Speech",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "explicitly-video-sync@local",
      "strict_min_version": "128.0"
    }
  }
}
